{
 "duration": 46.7,
 "voice": "bm_george",
 "sentences": [
  {
   "i": 1,
   "para": 1,
   "start": 0.0,
   "end": 1.75,
   "text": "Then come the lessons."
  },
  {
   "i": 2,
   "para": 1,
   "start": 2.05,
   "end": 8.45,
   "text": "Your tutor is one of the most respected scholars in the empire, and he is not here to be kind."
  },
  {
   "i": 3,
   "para": 2,
   "start": 9.15,
   "end": 12.41,
   "text": "You copy the classics, character by character."
  },
  {
   "i": 4,
   "para": 2,
   "start": 12.71,
   "end": 15.42,
   "text": "You memorise the words of Confucius."
  },
  {
   "i": 5,
   "para": 2,
   "start": 15.72,
   "end": 19.48,
   "text": "You learn history, morality, how a ruler should think."
  },
  {
   "i": 6,
   "para": 2,
   "start": 19.78,
   "end": 22.55,
   "text": "One wrong stroke and you start again."
  },
  {
   "i": 7,
   "para": 3,
   "start": 23.25,
   "end": 26.11,
   "text": "But your tutor is not only teaching you."
  },
  {
   "i": 8,
   "para": 3,
   "start": 26.41,
   "end": 27.84,
   "text": "He is watching you."
  },
  {
   "i": 9,
   "para": 3,
   "start": 28.14,
   "end": 29.7,
   "text": "How clever you are."
  },
  {
   "i": 10,
   "para": 3,
   "start": 30.0,
   "end": 31.25,
   "text": "How patient."
  },
  {
   "i": 11,
   "para": 3,
   "start": 31.55,
   "end": 33.79,
   "text": "How you react when you are wrong."
  },
  {
   "i": 12,
   "para": 3,
   "start": 34.09,
   "end": 37.04,
   "text": "Everything he sees can reach the Emperor."
  },
  {
   "i": 13,
   "para": 4,
   "start": 37.74,
   "end": 40.13,
   "text": "So you never show you are tired."
  },
  {
   "i": 14,
   "para": 4,
   "start": 40.43,
   "end": 42.84,
   "text": "You never show you are afraid."
  },
  {
   "i": 15,
   "para": 4,
   "start": 43.14,
   "end": 46.0,
   "text": "You are nine, and you are already performing."
  }
 ]
}